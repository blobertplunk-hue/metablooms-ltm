{"source_bundle": "MetaBlooms_OS_SHIPPED_PATCHED_20260130T003500Z.zip", "path": "metablooms/gates/zoop_unified_gate_pack_v1/schemas/zoop/zoop_rollback_receipt.schema.json", "chunk": 0, "content": "{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://metablooms.local/zoop/zoop_rollback_receipt.schema.json\",\n  \"title\": \"ZOOP Rollback Receipt\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"run_id\",\n    \"status\",\n    \"timestamp\"\n  ],\n  \"properties\": {\n    \"run_id\": {\n      \"type\": \"string\",\n      \"pattern\": \"^ZOOP-RUN-[0-9]{8}T[0-9]{6}Z$\"\n    },\n    \"status\": {\n      \"enum\": [\n        \"ROLLBACK_ATTEMPTED\",\n        \"ROLLBACK_COMPLETE\",\n        \"ROLLBACK_FAILED\"\n      ]\n    },\n    \"quarantine_path\": {\n      \"type\": \"string\"\n    },\n    \"post_rollback_validation\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"canonical_unchanged\",\n        \"working_quarantined\",\n        \"result\"\n      ],\n   ", "sha256": "a53643cd70da366bf687e0147a253e6e207e4ce1c8366e42ae9cf3140b79f131"}