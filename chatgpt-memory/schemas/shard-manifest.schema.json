{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shard Manifest",
  "description": "Global manifest produced by the ingestion pipeline. One document per pipeline run.",
  "type": "object",
  "required": ["manifest_id", "generated_at", "source_zip_sha256", "total_conversations", "total_messages", "shards"],
  "additionalProperties": false,
  "properties": {
    "manifest_id": {
      "type": "string",
      "description": "man_{sha256(source_zip_sha256)[:8]}_{generated_at_epoch}",
      "pattern": "^man_[a-f0-9]{8}_[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of manifest generation."
    },
    "source_zip_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the source export zip. Ground truth hash."
    },
    "source_zip_size_bytes": {
      "type": "integer"
    },
    "pipeline_version": {
      "type": "string",
      "description": "Version of parse_export.py used.",
      "examples": ["1.0.0"]
    },
    "total_conversations": {
      "type": "integer",
      "minimum": 0
    },
    "total_messages": {
      "type": "integer",
      "minimum": 0
    },
    "date_range": {
      "type": "object",
      "properties": {
        "earliest_utc": { "type": "string", "format": "date-time" },
        "latest_utc": { "type": "string", "format": "date-time" }
      }
    },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shard_index", "filename", "sha256", "conversation_count", "message_count", "first_create_time", "last_create_time"],
        "additionalProperties": false,
        "properties": {
          "shard_index": { "type": "integer", "minimum": 0 },
          "filename": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer" },
          "conversation_count": { "type": "integer" },
          "message_count": { "type": "integer" },
          "first_create_time": { "type": "string", "format": "date-time" },
          "last_create_time": { "type": "string", "format": "date-time" },
          "conv_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "All conv_ids in this shard, in shard order."
          }
        }
      }
    }
  }
}
